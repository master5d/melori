# Справочные клоны форков (master5d/speakrs, master5d/transcribe-rs) — лежат
# рядом для чтения, сборкой не используются. Были ошибочно закоммичены как
# gitlink-и БЕЗ .gitmodules: из-за этого checkout на CI падал
# «No url found for submodule path», а git status вечно показывал их изменёнными.
speakrs-fork/
transcribe-rs-fork/
.env.fish

# --- секреты: канон лаборатории (аудит 2026-08-21) ---
# Перечисление (.env / .env.local / .env.*.local) пропускает .env.bak-<stamp>,
# .env.production и .dev.vars — в estate-hub так висел бэкап с живым ключом
# гейтвея. Ловим семейства целиком, примеры возвращаем негацией.
.env*
!.env.example
.dev.vars*
!.dev.vars.example

# training/stress-lora: артефакты прогонов (адаптер 72МБ + батареи WAV) — не для git,
# воспроизводимы конвейером за ~50 мин и <$1; в git только код и конфиг конвейера
training/stress-lora/artifacts/

